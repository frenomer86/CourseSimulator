            ]
          }
        ]
      },
      {
        "id": "pol-0007",
        "type": "policy",
        "name": "records-operator",
        "statements": [
          {
            "effect": "Allow",
            "actions": [
              "s3:GetObject",
              "s3:PutObject",
              "rds:DescribeDBInstances"
            ],
            "resources": [
              "bucket:student-records",
              "db:records-db"
            ]
          }
        ]
      },
      {
        "id": "usr-0008",
        "type": "user",
        "name": "kofi",
        "policies": [
          "pol-0006"
        ],
        "mfa": false,
        "accessKeys": 2
      }
    ]
