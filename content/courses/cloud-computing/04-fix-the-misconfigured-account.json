      "user": "kofi",
      "mfa": true,
      "maxKeys": 1,
      "noWildcard": true,
      "hasPolicy": "records-operator"
    },
    {
      "type": "cloud.findings",
      "label": "Scanner clean",
      "maxHigh": 0,
      "maxMedium": 0
    },
    {
      "type": "cloud.exists",
      "label": "The web server still exists",
      "kind": "vm",
      "name": "records-web"
    }
  ],
  "realityNote": "Every one of these findings has caused a real breach: open S3 buckets of personal records, databases on the public internet, leaked long-lived keys. Cloud security posture management tools run exactly this scan continuously."
