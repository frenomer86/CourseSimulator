  "hints": [
    "Edit each resource from its row; the scanner updates as you go.",
    "The database should accept connections only from the web servers: in db-sg, allow 3306 from source sg:sg-0001 instead of 0.0.0.0/0.",
    "For kofi: tick MFA, set access keys to 1, untick administrator and tick records-operator."
  ],
  "checks": [
    {
      "type": "cloud.exists",
