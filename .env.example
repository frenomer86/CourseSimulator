# Copy to .env on the server. Never commit .env.
# A long random password for the Postgres container (only reachable inside Docker).
POSTGRES_PASSWORD=change-me-to-something-long-and-random
# Your domain, e.g. lab.example.edu.gh (DNS A record pointing at the VPS). Caddy gets HTTPS for it.
# While you only have an IP, use http://<ip> so Caddy serves plain HTTP.
DOMAIN=localhost
