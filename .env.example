# Copy to .env on the server. Never commit .env.
# A long random password for the Postgres container (only reachable inside Docker).
POSTGRES_PASSWORD=change-me-to-something-long-and-random
# Your domain, e.g. lab.example.edu.gh (DNS A record pointing at the VPS). Caddy gets HTTPS for it.
# While you only have an IP, use http://<ip> so Caddy serves plain HTTP.
DOMAIN=localhost
# Long random secret (32+ characters) that derives research ids from account ids for learning
# analytics. Keep it out of the database and back it up separately; never change it once data
# exists, or learners' histories split. See docs/05-LEARNING-ANALYTICS-AND-RESEARCH-DATA.md.
RESEARCH_SALT=change-me-to-a-different-long-random-secret
